module std_msgs { module msg { module dds_ {
@final struct String_ { string data; };
@final struct Float64_ { double data; };
@final struct Float32_ { float data; };
@final struct Int32_ { long data; };
@final struct Int64_ { long long data; };
@final struct Bool_ { boolean data; };
}; }; };
module rmw_dds_common { module msg { module dds_ {
@final struct Gid_ { octet data[16]; };
@final struct NodeEntitiesInfo_ {
 string<256> node_namespace;
 string<256> node_name;
 sequence<Gid_> reader_gid_seq;
 sequence<Gid_> writer_gid_seq;
};
@final struct ParticipantEntitiesInfo_ {
 Gid_ gid;
 sequence<NodeEntitiesInfo_> node_entities_info_seq;
};
}; }; };
