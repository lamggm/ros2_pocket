// ROS2 Humble rmw_dds_common1.6: same DDS wire names, explicitly selected GID24.
module rmw_dds_common { module msg { module dds_ {
@final struct Gid_ { octet data[24]; };
@final struct NodeEntitiesInfo_ {
 string<256> node_namespace;
 string<256> node_name;
 sequence<Gid_> reader_gid_seq;
 sequence<Gid_> writer_gid_seq;
};
@final struct ParticipantEntitiesInfo_ {
 Gid_ gid;
 sequence<NodeEntitiesInfo_> node_entities_info_seq;
};
}; }; };
